# Backend Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
# Examples:
# Standard local: postgresql://postgres:postgres@localhost:5432/campus_lost_found
# Cloud / Neon / Supabase: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_lost_found

# Google Gemini API Key (Strictly required for multimodal AI matching via @google/genai)
GEMINI_API_KEY=your_gemini_api_key_here